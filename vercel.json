{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/(runs|releases)/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
