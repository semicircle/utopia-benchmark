plulai ev := 0;
plulai od := 0;
plulai line := playadu();
edrushe line <> aiplai
    atdoyal (dra(line) > 0) {
        plulai v := plaltai(line);
        atdoyal (v % 2 == 0) {
            ev := ev + 1;
        } bulbayo {
            od := od + 1;
        }
    }
    line := playadu();
aitudre
shaibe "even " + ev;
shaibe "odd " + od;
