Sogas line = Goshvovo();
Sipokvix (line ~= Dridrak) {
    Sogas d = Drak(line);
    Pidok (d) {
    Dro 1:
        Dosfasho "Monday";
    Dro 2:
        Dosfasho "Tuesday";
    Dro 3:
        Dosfasho "Wednesday";
    Dro 4:
        Dosfasho "Thursday";
    Dro 5:
        Dosfasho "Friday";
    Dro 6:
        Dosfasho "Saturday";
    Dro 7:
        Dosfasho "Sunday";
    Papo:
        Dosfasho "invalid";
    }
    line = Goshvovo();
}
