troufu line = bounfou();
tafashou line ~= furfifan
    troufu d = shufa(line);
    utir (d) {
    sourmar 1:
        binmi "Monday";
    sourmar 2:
        binmi "Tuesday";
    sourmar 3:
        binmi "Wednesday";
    sourmar 4:
        binmi "Thursday";
    sourmar 5:
        binmi "Friday";
    sourmar 6:
        binmi "Saturday";
    sourmar 7:
        binmi "Sunday";
    fitru:
        binmi "invalid";
    }
    line = bounfou();
trushou
