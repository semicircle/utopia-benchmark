troufu evens = 0;
troufu odds = 0;
troufu line = bounfou();
tafashou line ~= furfifan
    sitrartu line ~= "" fisu drufirsa
        troufu n = shufa(line);
        sitrartu n % 2 == 0 fisu drufirsa
            evens = evens + 1;
        drumin tru drufirsa
            odds = odds + 1;
        drumin
    drumin
    line = bounfou();
trushou
binmi "even " + evens;
binmi "odd " + odds;
