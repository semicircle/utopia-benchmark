weltuxle evens := 0;
weltuxle odds := 0;
weltuxle line := lono();
krenul (line <> leitchux) {
    nei (dushzosh(line) > 0) {
        weltuxle v := leidush(line);
        nei (v yeil 2 == 0) {
            evens := evens + 1;
        } wogeish {
            odds := odds + 1;
        }
    }
    line := lono();
}
leshdei "even " + evens;
leshdei "odd " + odds;
