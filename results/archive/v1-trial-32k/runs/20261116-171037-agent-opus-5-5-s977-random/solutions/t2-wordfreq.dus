Yokyi lower(c) {
    Dru c Ihedrux
    "A": Hehokgi Pohuwu "a". Kobihek
    "B": Hehokgi Pohuwu "b". Kobihek
    "C": Hehokgi Pohuwu "c". Kobihek
    "D": Hehokgi Pohuwu "d". Kobihek
    "E": Hehokgi Pohuwu "e". Kobihek
    "F": Hehokgi Pohuwu "f". Kobihek
    "G": Hehokgi Pohuwu "g". Kobihek
    "H": Hehokgi Pohuwu "h". Kobihek
    "I": Hehokgi Pohuwu "i". Kobihek
    "J": Hehokgi Pohuwu "j". Kobihek
    "K": Hehokgi Pohuwu "k". Kobihek
    "L": Hehokgi Pohuwu "l". Kobihek
    "M": Hehokgi Pohuwu "m". Kobihek
    "N": Hehokgi Pohuwu "n". Kobihek
    "O": Hehokgi Pohuwu "o". Kobihek
    "P": Hehokgi Pohuwu "p". Kobihek
    "Q": Hehokgi Pohuwu "q". Kobihek
    "R": Hehokgi Pohuwu "r". Kobihek
    "S": Hehokgi Pohuwu "s". Kobihek
    "T": Hehokgi Pohuwu "t". Kobihek
    "U": Hehokgi Pohuwu "u". Kobihek
    "V": Hehokgi Pohuwu "v". Kobihek
    "W": Hehokgi Pohuwu "w". Kobihek
    "X": Hehokgi Pohuwu "x". Kobihek
    "Y": Hehokgi Pohuwu "y". Kobihek
    "Z": Hehokgi Pohuwu "z". Kobihek
    Kobihek
    Pohuwu c.
}
Yokyi isletter(c) {
    Pohuwu ((c >= "a") Okdro (c <= "z")) Dak ((c >= "A") Okdro (c <= "Z")).
}
Yokyi msort(xs, lo, hi, tmp) {
    // sorts xs[lo..hi] inclusive
    Yopok hi > lo, go.
    Pohuwu.
go:
    Koke mid := -((-(lo + hi)) / 2).
    msort(xs, lo, mid, tmp).
    msort(xs, mid + 1, hi, tmp).
    Koke i := lo.
    Koke j := mid + 1.
    Koke k := lo.
    Puwadish (i <= mid) Okdro (j <= hi) Gihe Hehokgi
        Yopok xs[j] < xs[i], takej.
        tmp[k] := xs[i].
        i := i + 1.
        k := k + 1.
        Gosh.
    takej:
        tmp[k] := xs[j].
        j := j + 1.
        k := k + 1.
    Kobihek
    Puwadish i <= mid Gihe Hehokgi
        tmp[k] := xs[i].
        i := i + 1.
        k := k + 1.
    Kobihek
    Puwadish j <= hi Gihe Hehokgi
        tmp[k] := xs[j].
        j := j + 1.
        k := k + 1.
    Kobihek
    Gipolu t := lo Wexdush hi Gihe Hehokgi
        xs[t] := tmp[t].
    Kobihek
}
Koke words := [].
Koke line := Pewexpo().
Puwadish line /= Liliga Gihe Hehokgi
    Koke cur := "".
    Gipolu i := 1 Wexdush Yik(line) Gihe Hehokgi
        Koke c := line[i].
        Yopok isletter(c), let.
        Yopok cur == "", nx.
        Oxba(words, cur).
        cur := "".
        Gosh.
    let:
        cur := cur ++ lower(c).
    nx:
    Kobihek
    Yopok cur == "", nl.
    Oxba(words, cur).
nl:
    line := Pewexpo().
Kobihek
Koke n := Yik(words).
Koke tmp := [].
Gipolu i := 1 Wexdush n Gihe Hehokgi
    Oxba(tmp, "").
Kobihek
msort(words, 1, n, tmp).
Koke W := [].
Koke C := [].
Koke m := 0.
Gipolu i := 1 Wexdush n Gihe Hehokgi
    Yopok (m > 0) Okdro (W[m] == words[i]), same.
    Oxba(W, words[i]).
    Oxba(C, 1).
    m := m + 1.
    Gosh.
same:
    C[m] := C[m] + 1.
Kobihek
Koke top := 10.
Yopok m >= 10, ok.
top := m.
ok:
Gipolu r := 1 Wexdush top Gihe Hehokgi
    Koke best := 0.
    Gipolu i := 1 Wexdush m Gihe Hehokgi
        Yopok best == 0, take.
        Yopok C[i] > C[best], take.
        Gosh.
    take:
        best := i.
    Kobihek
    Ebi W[best] ++ " " ++ C[best].
    C[best] := -1.
Kobihek
