Yokyi lowc(c) {
    Yopok (c >= "A") Okdro (c <= "Z"), isup.
    Pohuwu c.
isup:
    Koke up := "ABCDEFGHIJKLMNOPQRSTUVWXYZ".
    Koke low := "abcdefghijklmnopqrstuvwxyz".
    Koke lo := 1.
    Koke hi := 26.
    Puwadish lo < hi Gihe Hehokgi
        Koke mid := (lo + hi - 1) / 2.
        Yopok up[mid] >= c, goleft.
        lo := mid + 1.
        Gosh.
    goleft:
        hi := mid.
    Kobihek
    Pohuwu low[lo].
}

Yokyi less(x, y, mode) {
    Yopok mode == 1, m1.
    Koke cx := x[2].
    Koke cy := y[2].
    Yopok cx /= cy, diff.
    Pohuwu x[1] < y[1].
diff:
    Pohuwu cx > cy.
m1:
    Pohuwu x < y.
}

Yokyi msort(xs, mode) {
    Koke n := Yik(xs).
    Yopok n > 1, go.
    Pohuwu xs.
go:
    Koke h := n / 2.
    Koke a := [].
    Koke b := [].
    Gipolu i := 1 Wexdush h Gihe Hehokgi
        Oxba(a, xs[i]).
    Kobihek
    Gipolu i := h + 1 Wexdush n Gihe Hehokgi
        Oxba(b, xs[i]).
    Kobihek
    a := msort(a, mode).
    b := msort(b, mode).
    Koke r := [].
    Koke i := 1.
    Koke j := 1.
    Koke la := Yik(a).
    Koke lb := Yik(b).
    Puwadish (i <= la) Okdro (j <= lb) Gihe Hehokgi
        Yopok less(b[j], a[i], mode), takeb.
        Oxba(r, a[i]).
        i := i + 1.
        Gosh.
    takeb:
        Oxba(r, b[j]).
        j := j + 1.
    Kobihek
    Puwadish i <= la Gihe Hehokgi
        Oxba(r, a[i]).
        i := i + 1.
    Kobihek
    Puwadish j <= lb Gihe Hehokgi
        Oxba(r, b[j]).
        j := j + 1.
    Kobihek
    Pohuwu r.
}

Koke words := [].
Koke line := Pewexpo().
Puwadish line /= Liliga Gihe Hehokgi
    Koke cur := "".
    Gipolu i := 1 Wexdush Yik(line) Gihe Hehokgi
        Koke c := line[i].
        Yopok ((c >= "a") Okdro (c <= "z")) Dak ((c >= "A") Okdro (c <= "Z")), letter.
        Yopok Yik(cur) == 0, nl.
        Oxba(words, cur).
        cur := "".
    nl:
        Gosh.
    letter:
        cur := cur ++ lowc(c).
    Kobihek
    Yopok Yik(cur) == 0, eol.
    Oxba(words, cur).
eol:
    line := Pewexpo().
Kobihek

Koke sw := msort(words, 1).
Koke pairs := [].
Koke k := 1.
Koke n := Yik(sw).
Puwadish k <= n Gihe Hehokgi
    Koke w := sw[k].
    Koke cnt := 0.
    Puwadish (k <= n) Okdro (sw[k] == w) Gihe Hehokgi
        cnt := cnt + 1.
        k := k + 1.
    Kobihek
    Oxba(pairs, [w, cnt]).
Kobihek
Koke sp := msort(pairs, 2).
Koke m := Yik(sp).
Yopok m <= 10, ok10.
m := 10.
ok10:
Gipolu i := 1 Wexdush m Gihe Hehokgi
    Koke e := sp[i].
    Ebi e[1] ++ " " ++ e[2].
Kobihek
