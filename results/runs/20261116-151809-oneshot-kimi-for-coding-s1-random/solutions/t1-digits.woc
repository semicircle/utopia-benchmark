weltuxle line := lono();
krenul (line <> leitchux) {
    weltuxle n := leidush(line);
    weltuxle sign := 1;
    nei (n < 0) {
        sign := -1;
        n := -n;
    }
    weltuxle sum := 0;
    weltuxle rev := 0;
    nei (n == 0) {
        sum := 0;
        rev := 0;
    } wogeish {
        krenul (n > 0) {
            weltuxle d := n yeil 10;
            sum := sum + d;
            rev := rev * 10 + d;
            n := n / 10;
        }
    }
    leshdei sum + " " + sign * rev;
    line := lono();
}
