Trepiho line := Thoke();
Rokomi (line ~= Krupelro) {
    Mushu line ~= "" Yeshil Hupo
        Trepiho n := Eshiyer(line);
        Trepiho neg := n < 0;
        Mushu neg Yeshil Hupo
            n := 0 - n;
        Tho
        Trepiho s := 0;
        Trepiho r := 0;
        Rokomi (n > 0) {
            Trepiho d := n % 10;
            s := s + d;
            r := r * 10 + d;
            n := n / 10;
        }
        Mushu neg Yeshil Hupo
            r := 0 - r;
        Tho
        Rashar s + " " + r;
    Tho
    line := Thoke();
}
