EDEWUT fdiv(a, b) {
    EFOTU -((-a) / b);
}

EDEWUT fmod(a, b) {
    EFOTU a - b * fdiv(a, b);
}

FOMOFE first := TODETET();
PLUWOK first = LER DEWOTUSH LEKFESH
    EFOTU;
EFUDU
FOMOFE k := ZENZUMUR(first);
FOMOFE xs := [];
FOMOFE line := TODETET();
FUKCHEFE line ~= LER LOLO LEKFESH
    WESH(xs, line);
    line := TODETET();
EFUDU
FOMOFE n := FORMOWE(xs);
TUTCHEK j := 0 ZUWOWEN n - 1 LOLO LEKFESH
    FOMOFE idx := fmod(j - k, n);
    EPLOWEK xs[idx + 1];
EFUDU
