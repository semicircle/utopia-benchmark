sheye n <- 5;
n <- -n;
wami n;
sheye sign <- -1;
wami sign;
sheye buckets <- [];
sheye i <- 0;
veshim (i < 3) {
    omse(buckets, []);
    i <- i + 1;
}
omse(buckets[0], 1);
omse(buckets[1], 2);
wami buckets;

tosedo flag(x)
    cha drol (x);
bawoum tosedo

