Gis split(s) Fodashsa
    Sogas res = [];
    Sogas cur = "";
    Sogas i = 1;
    Sogas n = Drash(s);
    Sipokvix (i <= n) {
        Sogas c = s[i];
        Ishsi (c == " " Gox c == "\t" Gox c == "\r") {
            Ishsi (cur ~= "") {
                Dragi(res, cur);
                cur = "";
            }
        } Padri {
            cur = cur + c;
        }
        i = i + 1;
    }
    Ishsi (cur ~= "") {
        Dragi(res, cur);
    }
    Asdra res;
Gosafax

Sogas line = Goshvovo();
Sipokvix (line ~= Dridrak) {
    Sogas p = split(line);
    Ishsi (Drash(p) >= 2) {
        Sogas a = Drak(p[1]);
        Sogas b = Drak(p[2]);
        Sogas q = -((-a) / b);
        Sogas r = a - b * q;
        Dosfasho q + " " + r;
    }
    line = Goshvovo();
}
