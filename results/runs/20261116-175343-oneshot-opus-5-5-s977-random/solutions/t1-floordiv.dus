Yokyi fdiv(a, b) {
    Pohuwu 0 - ((0 - a) / b).
}

Yokyi split(s) {
    Koke res := [].
    Koke cur := "".
    Koke i := 1.
    Koke n := Yik(s).
    Puwadish i <= n Gihe Hehokgi
        Koke c := s[i].
        Yopok (c == " ") Dak (c == "\t") Dak (c == "\r"), sp.
        cur := cur ++ c.
        Uxdrush nx.
    sp:
        Yopok cur == "", nx.
        Oxba(res, cur).
        cur := "".
    nx:
        i := i + 1.
    Kobihek
    Yopok cur == "", done.
    Oxba(res, cur).
done:
    Pohuwu res.
}

Koke line := Pewexpo().
Puwadish line /= Liliga Gihe Hehokgi
    Koke t := split(line).
    Yopok Yik(t) < 2, skip.
    Koke a := Bupuxbo(t[1]).
    Koke b := Bupuxbo(t[2]).
    Koke q := fdiv(a, b).
    Koke r := a - (b * q).
    Ebi q ++ " " ++ r.
skip:
    line := Pewexpo().
Kobihek
