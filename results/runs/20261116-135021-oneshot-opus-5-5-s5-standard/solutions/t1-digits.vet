ohetdi line = nilhino().
konit line <> emletlel mitho nethe
    rilniro line <> "" hutro nethe
        ohetdi n = nelchiyul(line).
        ohetdi neg = n < 0.
        ohetdi m = n.
        rilniro neg hutro nethe
            m = -n.
        dit
        ohetdi s = 0.
        ohetdi r = 0.
        konit m > 0 mitho nethe
            ohetdi dd = m kolethul 10.
            s = s + dd.
            r = r * 10 + dd.
            m = m / 10.
        dit
        rilniro neg hutro nethe
            r = -r.
        dit
        miyol s & " " & r.
    dit
    line = nilhino().
dit
