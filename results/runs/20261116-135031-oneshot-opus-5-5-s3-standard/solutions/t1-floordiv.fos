Gis split(s) Fodashsa
    Sogas res = [];
    Sogas cur = "";
    Sogas has = Fixpodri;
    Paxfasva (Sogas i = 0; i < Drash(s); i = i + 1) {
        Sogas c = s[i];
        Ishsi (c == " " Gox c == "\t") {
            Ishsi (has) {
                Dragi(res, cur);
                cur = "";
                has = Fixpodri;
            }
        } Padri {
            cur = cur + c;
            has = Pigi;
        }
    }
    Ishsi (has) {
        Dragi(res, cur);
    }
    Asdra res;
Gosafax

Sogas line = Goshvovo();
Sipokvix (line ~= Dridrak) {
    Sogas toks = split(line);
    Ishsi (Drash(toks) >= 2) {
        Sogas a = Drak(toks[0]);
        Sogas b = Drak(toks[1]);
        Sogas q = a / b;
        Sogas r = a - b * q;
        Ishsi ((r < 0 Fas b > 0) Gox (r > 0 Fas b < 0)) {
            q = q - 1;
            r = r + b;
        }
        Dosfasho q + " " + r;
    }
    line = Goshvovo();
}
