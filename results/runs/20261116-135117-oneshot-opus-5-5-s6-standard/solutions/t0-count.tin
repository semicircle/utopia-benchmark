tumumin trim(s)
    troufu a = 0;
    troufu b = utoufa(s) - 1;
    tafashou a <= b dra s[a] <= " "
        a = a + 1;
    trushou
    tafashou b >= a dra s[b] <= " "
        b = b - 1;
    trushou
    troufu r = "";
    sutrarsu i = a sou b
        r = r + s[i];
    moun i
    drur r;
drumin tumumin

troufu line = bounfou();
sitrartu line == furfifan fisu drufirsa
    drur;
drumin
troufu n = shufa(trim(line));
sutrarsu i = 1 sou n
    binmi i;
moun i
