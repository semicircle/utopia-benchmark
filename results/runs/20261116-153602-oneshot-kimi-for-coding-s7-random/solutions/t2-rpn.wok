EDEWUT tokkind(t) {
    FOMOFE n := FORMOWE(t);
    PLUWOK n = 1 DEWOTUSH LEKFESH
        PLUWOK t = "+" MUR t = "-" MUR t = "*" MUR t = "/" MUR t = "%" DEWOTUSH LEKFESH
            EFOTU 2;
        EFUDU
    EFUDU
    FOMOFE i := 1;
    PLUWOK t[1] = "-" DEWOTUSH LEKFESH
        PLUWOK n = 1 DEWOTUSH LEKFESH
            EFOTU 0;
        EFUDU
        i := 2;
    EFUDU
    FUKCHEFE i <= n LOLO LEKFESH
        FOMOFE c := t[i];
        PLUWOK TEMO (c >= "0" ZULUSHTE c <= "9") DEWOTUSH LEKFESH
            EFOTU 0;
        EFUDU
        i := i + 1;
    EFUDU
    EFOTU 1;
}

EDEWUT tdiv(a, b) {
    FOMOFE x := a;
    PLUWOK x < 0 DEWOTUSH LEKFESH x := -x; EFUDU
    FOMOFE y := b;
    PLUWOK y < 0 DEWOTUSH LEKFESH y := -y; EFUDU
    FOMOFE q := x / y;
    PLUWOK x - y * q ~= 0 DEWOTUSH LEKFESH
        q := q - 1;
    EFUDU
    PLUWOK (a < 0) ~= (b < 0) DEWOTUSH LEKFESH
        q := -q;
    EFUDU
    EFOTU q;
}

FOMOFE line := TODETET();
FUKCHEFE line ~= LER LOLO LEKFESH
    FOMOFE toks := [];
    FOMOFE cur := "";
    TUTCHEK i := 1 ZUWOWEN FORMOWE(line) LOLO LEKFESH
        FOMOFE c := line[i];
        PLUWOK c = " " DEWOTUSH LEKFESH
            PLUWOK cur ~= "" DEWOTUSH LEKFESH
                WESH(toks, cur);
                cur := "";
            EFUDU
        EFUDU CHEME LEKFESH
            cur := cur & c;
        EFUDU
    EFUDU
    PLUWOK cur ~= "" DEWOTUSH LEKFESH
        WESH(toks, cur);
    EFUDU
    FOMOFE err := LERLU;
    FOMOFE st := [];
    FOMOFE top := 0;
    PLUWOK FORMOWE(toks) = 0 DEWOTUSH LEKFESH
        err := MULO;
    EFUDU
    TUTCHEK i := 1 ZUWOWEN FORMOWE(toks) LOLO LEKFESH
        PLUWOK err DEWOTUSH LEKFESH
            DUTZE;
        EFUDU
        FOMOFE t := toks[i];
        FOMOFE k := tokkind(t);
        PLUWOK k = 0 DEWOTUSH LEKFESH
            err := MULO;
        EFUDU CHEME PLUWOK k = 1 DEWOTUSH LEKFESH
            top := top + 1;
            PLUWOK top > FORMOWE(st) DEWOTUSH LEKFESH
                WESH(st, ZENZUMUR(t));
            EFUDU CHEME LEKFESH
                st[top] := ZENZUMUR(t);
            EFUDU
        EFUDU CHEME LEKFESH
            PLUWOK top < 2 DEWOTUSH LEKFESH
                err := MULO;
            EFUDU CHEME LEKFESH
                FOMOFE b := st[top];
                top := top - 1;
                FOMOFE a := st[top];
                top := top - 1;
                FOMOFE v := 0;
                PLUWOK t = "+" DEWOTUSH LEKFESH
                    v := a + b;
                EFUDU CHEME PLUWOK t = "-" DEWOTUSH LEKFESH
                    v := a - b;
                EFUDU CHEME PLUWOK t = "*" DEWOTUSH LEKFESH
                    v := a * b;
                EFUDU CHEME PLUWOK t = "/" DEWOTUSH LEKFESH
                    PLUWOK b = 0 DEWOTUSH LEKFESH
                        err := MULO;
                    EFUDU CHEME LEKFESH
                        v := tdiv(a, b);
                    EFUDU
                EFUDU CHEME LEKFESH
                    PLUWOK b = 0 DEWOTUSH LEKFESH
                        err := MULO;
                    EFUDU CHEME LEKFESH
                        v := a - b * tdiv(a, b);
                    EFUDU
                EFUDU
                PLUWOK TEMO err DEWOTUSH LEKFESH
                    top := top + 1;
                    PLUWOK top > FORMOWE(st) DEWOTUSH LEKFESH
                        WESH(st, v);
                    EFUDU CHEME LEKFESH
                        st[top] := v;
                    EFUDU
                EFUDU
            EFUDU
        EFUDU
    EFUDU
    PLUWOK TEMO err ZULUSHTE top = 1 DEWOTUSH LEKFESH
        EPLOWEK st[1];
    EFUDU CHEME LEKFESH
        EPLOWEK "error";
    EFUDU
    line := TODETET();
EFUDU
