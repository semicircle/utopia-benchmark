troufu ev = 0;
troufu od = 0;
troufu line = bounfou();
tafashou line ~= furfifan
    sitrartu utoufa(line) > 0 fisu drufirsa
        troufu n = shufa(line);
        sitrartu (n % 2) == 0 fisu drufirsa
            ev = ev + 1;
        drumin tru drufirsa
            od = od + 1;
        drumin
    drumin
    line = bounfou();
trushou
binmi "even " + ev;
binmi "odd " + od;
