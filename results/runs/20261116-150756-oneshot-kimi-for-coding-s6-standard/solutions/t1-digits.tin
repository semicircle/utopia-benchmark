troufu line = bounfou();
tafashou line ~= furfifan
    troufu n = shufa(line);
    troufu sign = 1;
    sitrartu n < 0 fisu drufirsa
        sign = -1;
        n = -n;
    drumin
    troufu sum = 0;
    troufu rev = 0;
    sitrartu n == 0 fisu drufirsa
        sum = 0;
        rev = 0;
    drumin
    tafashou n > 0
        troufu d = n % 10;
        sum = sum + d;
        rev = rev * 10 + d;
        n = n / 10;
    trushou
    sitrartu sign == -1 dra rev ~= 0 fisu drufirsa
        rev = -rev;
    drumin
    binmi sum + " " + rev;
    line = bounfou();
trushou
