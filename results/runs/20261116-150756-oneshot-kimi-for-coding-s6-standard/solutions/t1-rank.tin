tumumin splittok(s)
    troufu parts = [];
    troufu cur = "";
    troufu i = 0;
    tafashou i < utoufa(s)
        troufu c = s[i];
        sitrartu c == " " fisu drufirsa
            sitrartu cur ~= "" fisu drufirsa
                marboun(parts, cur);
            drumin
            cur = "";
        drumin tru drufirsa
            cur = cur + c;
        drumin
        i = i + 1;
    trushou
    sitrartu cur ~= "" fisu drufirsa
        marboun(parts, cur);
    drumin
    drur parts;
drumin tumumin

troufu first = bounfou();
troufu xs = [];
sitrartu first ~= furfifan fisu drufirsa
    troufu toks = splittok(first);
    troufu ti = 0;
    tafashou ti < utoufa(toks)
        marboun(xs, shufa(toks[ti]));
        ti = ti + 1;
    trushou
drumin
troufu line = bounfou();
tafashou line ~= furfifan
    troufu q = shufa(line);
    troufu smaller = 0;
    troufu found = fufir;
    troufu i = 0;
    tafashou i < utoufa(xs)
        sitrartu xs[i] < q fisu drufirsa
            smaller = smaller + 1;
        drumin
        sitrartu xs[i] == q fisu drufirsa
            found = sibitrou;
        drumin
        i = i + 1;
    trushou
    sitrartu found fisu drufirsa
        binmi smaller + " found";
    drumin tru drufirsa
        binmi smaller + " missing";
    drumin
    line = bounfou();
trushou
