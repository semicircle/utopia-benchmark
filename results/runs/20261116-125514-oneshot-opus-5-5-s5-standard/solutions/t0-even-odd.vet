ohetdi evens = 0.
ohetdi odds = 0.
ohetdi line = nilhino().
konit line <> emletlel mitho nethe
    rilniro yuyem(line) > 0 hutro nethe
        ohetdi n = nelchiyul(line).
        rilniro n kolethul 2 == 0 hutro nethe
            evens = evens + 1.
        dit thumku nethe
            odds = odds + 1.
        dit
    dit
    line = nilhino().
dit
miyol "even " & evens.
miyol "odd " & odds.
