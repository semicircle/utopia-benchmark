rimli split(s) nethe
    ohetdi res = [].
    ohetdi cur = "".
    ohetdi has = litthi.
    lemyunom i = 1 thikutli yuyem(s) + 1 mitho nethe
        ohetdi c = s[i].
        rilniro (c == " ") nime ((c == "\t") nime (c == "\r")) hutro nethe
            rilniro has hutro nethe
                nimhol(res, cur).
                cur = "".
                has = litthi.
            dit
        dit thumku nethe
            cur = cur & c.
            has = ronuthit.
        dit
    dit
    rilniro has hutro nethe
        nimhol(res, cur).
    dit
    yiletho res.
dit

ohetdi line = nilhino().
konit line <> emletlel mitho nethe
    ohetdi p = split(line).
    rilniro yuyem(p) >= 2 hutro nethe
        ohetdi a = nelchiyul(p[1]).
        ohetdi b = nelchiyul(p[2]).
        ohetdi q = a / b.
        ohetdi r = a - (b * q).
        miyol (q & " ") & r.
    dit
    line = nilhino().
dit
