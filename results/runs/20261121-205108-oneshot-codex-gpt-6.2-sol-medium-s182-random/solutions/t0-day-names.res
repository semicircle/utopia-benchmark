sheye line <- diwela();
veshim (line <> malwe) {
    moumare amdre odresdra(line)
    amdre 1
        wami "Monday";
    amdre 2
        wami "Tuesday";
    amdre 3
        wami "Wednesday";
    amdre 4
        wami "Thursday";
    amdre 5
        wami "Friday";
    amdre 6
        wami "Saturday";
    amdre 7
        wami "Sunday";
    amdre oli
        wami "invalid";
    bawoum moumare
    line <- diwela();
}
