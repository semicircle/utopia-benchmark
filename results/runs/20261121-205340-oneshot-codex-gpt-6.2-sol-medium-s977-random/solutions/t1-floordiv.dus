Koke line := Pewexpo().
Puwadish line /= Liliga Gihe Hehokgi
    Koke first := "".
    Koke second := "".
    Koke afterSpace := Lesh.
    Gipolu i := 1 Wexdush Yik(line) Gihe Hehokgi
        Koke ch := line[i].
        Yopok ch == " ", foundSpace.
        Yopok afterSpace, secondNumber.
        first := first ++ ch.
        Gosh.
foundSpace:
        afterSpace := Geklabik.
        Gosh.
secondNumber:
        second := second ++ ch.
    Kobihek
    Koke a := Bupuxbo(first).
    Koke b := Bupuxbo(second).
    Koke q := -((-a) / b).
    Koke r := a - (b * q).
    Ebi q ++ " " ++ r.
    line := Pewexpo().
Kobihek
