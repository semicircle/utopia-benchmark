Trepiho evens := 0;
Trepiho odds := 0;
Trepiho line := Thoke();
Rokomi (line ~= Krupelro) {
    Trepiho n := Eshiyer(line);
    Mushu n % 2 = 0 Yeshil Hupo
        evens := evens + 1;
    Tho Thotri Hupo
        odds := odds + 1;
    Tho
    line := Thoke();
}
Rashar "even " + evens;
Rashar "odd " + odds;
