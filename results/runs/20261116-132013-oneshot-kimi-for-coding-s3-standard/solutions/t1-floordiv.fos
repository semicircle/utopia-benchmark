Gis tokens(line) Fodashsa
    Sogas out = [];
    Sogas cur = "";
    Sogas i = 0;
    Sipokvix (i < Drash(line)) {
        Sogas c = line[i];
        Ishsi (c == " ") {
            Ishsi (Drash(cur) > 0) {
                Dragi(out, cur);
                cur = "";
            }
        } Padri {
            cur = cur + c;
        }
        i = i + 1;
    }
    Ishsi (Drash(cur) > 0) {
        Dragi(out, cur);
    }
    Asdra out;
Gosafax

Sogas line = Goshvovo();
Sipokvix (line ~= Dridrak) {
    Sogas t = tokens(line);
    Sogas a = Drak(t[0]);
    Sogas b = Drak(t[1]);
    Sogas q = a / b;
    Sogas r = a Dodogo b;
    Ishsi ((r ~= 0) Fas ((r > 0) ~= (b > 0))) {
        q = q - 1;
        r = r + b;
    }
    Dosfasho q + " " + r;
    line = Goshvovo();
}
