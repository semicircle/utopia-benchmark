nudro split(s) {
    plulai res := [];
    plulai cur := "";
    plulai i := 0;
    edrushe (i < dra(s))
        plulai c := s[i];
        atdoyal (c == " " tobe c == "\t") {
            atdoyal (dra(cur) > 0) {
                sutse(res, cur);
                cur := "";
            }
        } bulbayo {
            cur := cur + c;
        }
        i := i + 1;
    aitudre
    atdoyal (dra(cur) > 0) {
        sutse(res, cur);
    }
    druna res;
}

nudro todigits(s) {
    plulai d := [];
    plulai i := dra(s) - 1;
    edrushe (i >= 0)
        sutse(d, plaltai(s[i]));
        i := i - 1;
    aitudre
    druna d;
}

nudro add(a, b) {
    plulai r := [];
    plulai carry := 0;
    plulai n := dra(a);
    atdoyal (dra(b) > n) {
        n := dra(b);
    }
    shoyo i := 0 busale n - 1
        plulai s := carry;
        atdoyal (i < dra(a)) {
            s := s + a[i];
        }
        atdoyal (i < dra(b)) {
            s := s + b[i];
        }
        sutse(r, s % 10);
        carry := s / 10;
    pla i
    atdoyal (carry > 0) {
        sutse(r, carry);
    }
    druna r;
}

nudro mul(a, b) {
    plulai r := [];
    shoyo z := 1 busale dra(a) + dra(b)
        sutse(r, 0);
    pla z
    shoyo i := 0 busale dra(a) - 1
        plulai ai := a[i];
        atdoyal (ai <> 0) {
            shoyo j := 0 busale dra(b) - 1
                r[i + j] := r[i + j] + ai * b[j];
            pla j
        }
    pla i
    plulai carry := 0;
    shoyo k := 0 busale dra(r) - 1
        plulai v := r[k] + carry;
        r[k] := v % 10;
        carry := v / 10;
    pla k
    druna r;
}

nudro tostr(d) {
    plulai top := dra(d) - 1;
    edrushe (top > 0 rulsai d[top] == 0)
        top := top - 1;
    aitudre
    plulai s := "";
    plulai i := top;
    edrushe (i >= 0)
        s := s + d[i];
        i := i - 1;
    aitudre
    druna s;
}

plulai line := playadu();
edrushe (line <> aiplai)
    plulai p := split(line);
    atdoyal (dra(p) >= 2) {
        plulai a := todigits(p[0]);
        plulai b := todigits(p[1]);
        shaibe tostr(add(a, b)) + " " + tostr(mul(a, b));
    }
    line := playadu();
aitudre
