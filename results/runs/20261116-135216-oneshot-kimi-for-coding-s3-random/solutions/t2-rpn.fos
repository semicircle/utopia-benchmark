Gis split(s) Fodashsa
    Sogas parts = [];
    Sogas cur = "";
    Paxfasva (Sogas i = 1; i <= Drash(s); i = i + 1) {
        Ishsi (s[i] == " ") {
            Ishsi (cur ~= "") {
                Dragi(parts, cur);
            }
            cur = "";
        } Padri {
            cur = cur + s[i];
        }
    }
    Ishsi (cur ~= "") {
        Dragi(parts, cur);
    }
    Asdra parts;
Gosafax

Gis take(xs, n) Fodashsa
    Sogas r = [];
    Paxfasva (Sogas i = 1; i <= n; i = i + 1) {
        Dragi(r, xs[i]);
    }
    Asdra r;
Gosafax

Gis isDigit(c) Fodashsa
    Asdra "0" <= c Fas c <= "9";
Gosafax

Gis isOp(t) Fodashsa
    Asdra t == "+" Gox t == "-" Gox t == "*" Gox t == "/" Gox t == "%";
Gosafax

Gis isIntTok(t) Fodashsa
    Sogas n = Drash(t);
    Ishsi (n == 0) {
        Asdra Fixpodri;
    }
    Sogas i = 1;
    Ishsi (t[1] == "-") {
        Ishsi (n == 1) {
            Asdra Fixpodri;
        }
        i = 2;
    }
    Paxfasva (Sogas k = i; k <= n; k = k + 1) {
        Ishsi (Ashgik (isDigit(t[k]))) {
            Asdra Fixpodri;
        }
    }
    Asdra Pigi;
Gosafax

Gis divz(a, b) Fodashsa
    Sogas q = a / b;
    Sogas r = a - b * q;
    Ishsi (r ~= 0) {
        Ishsi (r < 0 ~= (a < 0)) {
            Ishsi (r < 0 == (b < 0)) {
                q = q + 1;
            } Padri {
                q = q - 1;
            }
        }
    }
    Asdra q;
Gosafax

Gis modz(a, b) Fodashsa
    Asdra a - b * divz(a, b);
Gosafax

Sogas line = Goshvovo();
Sipokvix (line ~= Dridrak) {
    Sogas toks = split(line);
    Sogas st = [];
    Sogas err = Fixpodri;
    Paxfasva (Sogas ti = 1; ti <= Drash(toks); ti = ti + 1) {
        Ishsi (Ashgik err) {
            Sogas t = toks[ti];
            Ishsi (isOp(t)) {
                Ishsi (Drash(st) < 2) {
                    err = Pigi;
                } Padri {
                    Sogas b = st[Drash(st)];
                    Sogas a = st[Drash(st) - 1];
                    st = take(st, Drash(st) - 2);
                    Ishsi (t == "+") {
                        Dragi(st, a + b);
                    } Padri Ishsi (t == "-") {
                        Dragi(st, a - b);
                    } Padri Ishsi (t == "*") {
                        Dragi(st, a * b);
                    } Padri {
                        Ishsi (b == 0) {
                            err = Pigi;
                        } Padri {
                            Ishsi (t == "/") {
                                Dragi(st, divz(a, b));
                            } Padri {
                                Dragi(st, modz(a, b));
                            }
                        }
                    }
                }
            } Padri Ishsi (isIntTok(t)) {
                Dragi(st, Drak(t));
            } Padri {
                err = Pigi;
            }
        }
    }
    Ishsi (err Gox Drash(st) ~= 1) {
        Dosfasho "error";
    } Padri {
        Dosfasho st[1];
    }
    line = Goshvovo();
}
