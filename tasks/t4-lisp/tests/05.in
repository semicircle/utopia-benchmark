(define x 10)
(define y (* x 2))
(define x 1)
(define (sq n) (* n n))
(define (abs n) (if (< n 0) (- n) n))
(define (fact n) (if (< n 2) 1 (* n (fact (- n 1)))))
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(cons 1 2)
(cons 1 (cons 2 (list)))
(list 1 2 3)
(list)
(car (list 4 5))
(cdr (list 4 5))
(null? (list))
(null? (list 1))
(list (list 1 2) (list) 3)
(define (len xs) (if (null? xs) 0 (+ 1 (len (cdr xs)))))
(len (list 1 2 3 4))
(define (range a b) (if (< a b) (cons a (range (+ a 1) b)) (list)))
(range 0 10)
(define (map f xs) (if (null? xs) (list) (cons (f (car xs)) (map f (cdr xs)))))
(map (lambda (n) (* n n)) (range 1 6))
(define (filter p xs) (if (null? xs) (list) (if (p (car xs)) (cons (car xs) (filter p (cdr xs))) (filter p (cdr xs)))))
(filter (lambda (n) (= 0 (remainder n 3))) (range 0 20))
(define (foldl f acc xs) (if (null? xs) acc (foldl f (f acc (car xs)) (cdr xs))))
(foldl + 0 (range 1 101))
(foldl (lambda (acc v) (cons v acc)) (list) (list 1 2 3))
(cons (list 1) 2)
car
