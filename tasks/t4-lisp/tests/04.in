(define x 10)
(define y (* x 2))
(define x 1)
(define (sq n) (* n n))
(define (abs n) (if (< n 0) (- n) n))
(define (fact n) (if (< n 2) 1 (* n (fact (- n 1)))))
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(define (adder k) (lambda (n) (+ n k)))
(define add5 (adder 5))
(add5 10)
((adder 3) 4)
((lambda (a b) (- a b)) 10 3)
(define (compose f g) (lambda (v) (f (g v))))
((compose add5 (adder 100)) 1)
(define k 1000)
(add5 1)
(let ((a 2) (b 3)) (* a b))
(let ((k 7)) (add5 k))
(let ((x 1)) (let ((x 2) (y x)) (+ x y)))
(begin 1 2 3)
(define (twice f) (lambda (v) (f (f v))))
((twice (twice add5)) 0)
add5
