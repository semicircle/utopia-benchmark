(define x 10)
(define y (* x 2))
(define x 1)
(define (sq n) (* n n))
(define (abs n) (if (< n 0) (- n) n))
(abs -5)
(abs 7)
(if 0 1 2)
(if #f 1 2)
(if (= 1 1) (+ 1 1) undefined-name)
(define (fact n) (if (< n 2) 1 (* n (fact (- n 1)))))
(fact 10)
(fact 20)
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(fib 15)
