func digitsOf(s) {
    let ds = [];
    for (let i = len(s) - 1; i >= 0; i = i - 1) {
        push(ds, num(s[i]));
    }
    return ds;
}

func text(ds) {
    let last = len(ds) - 1;
    while (last > 0) {
        if (ds[last] != 0) {
            break;
        }
        last = last - 1;
    }
    let out = "";
    for (let i = last; i >= 0; i = i - 1) {
        out = out & ds[i];
    }
    return out;
}

func normalize(ds) {
    let carry = 0;
    for (let i = 0; i < len(ds); i = i + 1) {
        let v = ds[i] + carry;
        ds[i] = v % 10;
        carry = v / 10;
    }
    while (carry > 0) {
        push(ds, carry % 10);
        carry = carry / 10;
    }
    return ds;
}

func add(a, b) {
    let n = len(a);
    if (len(b) > n) {
        n = len(b);
    }
    let out = [];
    for (let i = 0; i < n; i = i + 1) {
        let v = 0;
        if (i < len(a)) {
            v = v + a[i];
        }
        if (i < len(b)) {
            v = v + b[i];
        }
        push(out, v);
    }
    return normalize(out);
}

func mul(a, b) {
    let out = [];
    for (let i = 0; i < len(a) + len(b); i = i + 1) {
        push(out, 0);
    }
    for (let i = 0; i < len(a); i = i + 1) {
        for (let j = 0; j < len(b); j = j + 1) {
            out[i + j] = out[i + j] + a[i] * b[j];
        }
    }
    return normalize(out);
}

let line = readline();
while (line != none) {
    let sp = 0;
    while (line[sp] != " ") {
        sp = sp + 1;
    }
    let left = "";
    for (let i = 0; i < sp; i = i + 1) {
        left = left & line[i];
    }
    let right = "";
    for (let i = sp + 1; i < len(line); i = i + 1) {
        right = right & line[i];
    }
    let a = digitsOf(left);
    let b = digitsOf(right);
    print text(add(a, b)) & " " & text(mul(a, b));
    line = readline();
}
