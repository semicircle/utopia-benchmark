func part(s, start, n) {
    let out = "";
    for (let i = start; i < start + n; i = i + 1) {
        out = out & s[i];
    }
    return num(out);
}

func weekday(y, m, d) {
    let offsets = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    if (m < 3) {
        y = y - 1;
    }
    let w = (y + y / 4 - y / 100 + y / 400 + offsets[m - 1] + d) % 7;
    return names[w];
}

let line = readline();
while (line != none) {
    print weekday(part(line, 0, 4), part(line, 5, 2), part(line, 8, 2));
    line = readline();
}
