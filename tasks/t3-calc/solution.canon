func isDigit(c) {
    let digits = "0123456789";
    for (let i = 0; i < 10; i = i + 1) {
        if (digits[i] == c) {
            return true;
        }
    }
    return false;
}

func isSymbol(c) {
    let symbols = "+-*/%()";
    for (let i = 0; i < len(symbols); i = i + 1) {
        if (symbols[i] == c) {
            return true;
        }
    }
    return false;
}

# Splits a line into tokens: kinds gets "n" for a number (its value goes in
# vals) or the symbol itself. Returns false on any other character.
func tokenize(line, kinds, vals) {
    let i = 0;
    while (i < len(line)) {
        let c = line[i];
        if (c == " ") {
            i = i + 1;
        } else if (isDigit(c)) {
            let v = 0;
            let more = true;
            while (more) {
                v = v * 10 + num(line[i]);
                i = i + 1;
                more = false;
                if (i < len(line)) {
                    if (isDigit(line[i])) {
                        more = true;
                    }
                }
            }
            push(kinds, "n");
            push(vals, v);
        } else if (isSymbol(c)) {
            push(kinds, c);
            push(vals, 0);
            i = i + 1;
        } else {
            return false;
        }
    }
    return true;
}

# st[0] is the position of the next token; st[1] becomes true on an error.
func peek(kinds, st) {
    if (st[0] < len(kinds)) {
        return kinds[st[0]];
    }
    return "end";
}

func expr(kinds, vals, st) {
    let v = term(kinds, vals, st);
    if (st[1]) {
        return 0;
    }
    let k = peek(kinds, st);
    while (k == "+" or k == "-") {
        st[0] = st[0] + 1;
        let w = term(kinds, vals, st);
        if (st[1]) {
            return 0;
        }
        if (k == "+") {
            v = v + w;
        } else {
            v = v - w;
        }
        k = peek(kinds, st);
    }
    return v;
}

func term(kinds, vals, st) {
    let v = unary(kinds, vals, st);
    if (st[1]) {
        return 0;
    }
    let k = peek(kinds, st);
    while (k == "*" or k == "/" or k == "%") {
        st[0] = st[0] + 1;
        let w = unary(kinds, vals, st);
        if (st[1]) {
            return 0;
        }
        if (k == "*") {
            v = v * w;
        } else {
            if (w == 0) {
                st[1] = true;
                return 0;
            }
            if (k == "/") {
                v = v / w;
            } else {
                v = v % w;
            }
        }
        k = peek(kinds, st);
    }
    return v;
}

func unary(kinds, vals, st) {
    if (peek(kinds, st) == "-") {
        st[0] = st[0] + 1;
        let v = unary(kinds, vals, st);
        return -v;
    }
    return primary(kinds, vals, st);
}

func primary(kinds, vals, st) {
    let k = peek(kinds, st);
    if (k == "n") {
        let v = vals[st[0]];
        st[0] = st[0] + 1;
        return v;
    }
    if (k == "(") {
        st[0] = st[0] + 1;
        let v = expr(kinds, vals, st);
        if (st[1]) {
            return 0;
        }
        if (peek(kinds, st) != ")") {
            st[1] = true;
            return 0;
        }
        st[0] = st[0] + 1;
        return v;
    }
    st[1] = true;
    return 0;
}

func evaluate(line) {
    let kinds = [];
    let vals = [];
    if (not tokenize(line, kinds, vals)) {
        return "error";
    }
    if (len(kinds) == 0) {
        return "error";
    }
    let st = [0, false];
    let v = expr(kinds, vals, st);
    if (st[1]) {
        return "error";
    }
    if (st[0] != len(kinds)) {
        return "error";
    }
    return str(v);
}

let line = readline();
while (line != none) {
    print evaluate(line);
    line = readline();
}
