# Big numbers are lists of digits, least significant first, with no zero
# digits at the high end (zero itself is [0]).

func trim(ds) {
    let last = len(ds) - 1;
    while (last > 0) {
        if (ds[last] != 0) {
            break;
        }
        last = last - 1;
    }
    let out = [];
    for (let i = 0; i <= last; i = i + 1) {
        push(out, ds[i]);
    }
    return out;
}

func digitsOf(s) {
    let ds = [];
    for (let i = len(s) - 1; i >= 0; i = i - 1) {
        push(ds, num(s[i]));
    }
    return trim(ds);
}

# Compares two trimmed numbers: -1, 0 or 1.
func compare(a, b) {
    if (len(a) != len(b)) {
        if (len(a) < len(b)) {
            return -1;
        }
        return 1;
    }
    for (let i = len(a) - 1; i >= 0; i = i - 1) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

# a - b, for a >= b.
func subtract(a, b) {
    let out = [];
    let borrow = 0;
    for (let i = 0; i < len(a); i = i + 1) {
        let v = a[i] - borrow;
        if (i < len(b)) {
            v = v - b[i];
        }
        borrow = 0;
        if (v < 0) {
            v = v + 10;
            borrow = 1;
        }
        push(out, v);
    }
    return trim(out);
}

# ds * 10 + d.
func shiftIn(ds, d) {
    let out = [d];
    for (let i = 0; i < len(ds); i = i + 1) {
        push(out, ds[i]);
    }
    return trim(out);
}

func text(ds) {
    let out = "";
    for (let i = len(ds) - 1; i >= 0; i = i - 1) {
        out = out & ds[i];
    }
    return out;
}

let line = readline();
while (line != none) {
    let sp = 0;
    while (line[sp] != " ") {
        sp = sp + 1;
    }
    let left = "";
    for (let i = 0; i < sp; i = i + 1) {
        left = left & line[i];
    }
    let right = "";
    for (let i = sp + 1; i < len(line); i = i + 1) {
        right = right & line[i];
    }
    let b = digitsOf(right);
    let rem = [0];
    let quot = [];
    for (let i = 0; i < len(left); i = i + 1) {
        rem = shiftIn(rem, num(left[i]));
        let q = 0;
        while (compare(rem, b) >= 0) {
            rem = subtract(rem, b);
            q = q + 1;
        }
        push(quot, q);
    }
    let qs = [];
    for (let i = len(quot) - 1; i >= 0; i = i - 1) {
        push(qs, quot[i]);
    }
    print text(trim(qs)) & " " & text(rem);
    line = readline();
}
