let line = readline();
while (line != none) {
    let n = num(line);
    let negative = n < 0;
    if (negative) {
        n = -n;
    }
    let total = 0;
    let rev = 0;
    while (n > 0) {
        let d = n % 10;
        total = total + d;
        rev = rev * 10 + d;
        n = n / 10;
    }
    if (negative) {
        rev = -rev;
    }
    print total & " " & rev;
    line = readline();
}
