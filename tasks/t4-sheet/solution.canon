# Cells are numbered (row - 1) * 26 + column, column 0 for A.

func letterIndex(c) {
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for (let i = 0; i < 26; i = i + 1) {
        if (letters[i] == c) {
            return i;
        }
    }
    return -1;
}

func digitValue(c) {
    let digits = "0123456789";
    for (let i = 0; i < 10; i = i + 1) {
        if (digits[i] == c) {
            return i;
        }
    }
    return -1;
}

# The cell number for a name such as B7, or -1 if it is not a cell name.
func cellId(w) {
    if (len(w) < 2) {
        return -1;
    }
    if (len(w) > 3) {
        return -1;
    }
    let col = letterIndex(w[0]);
    let d1 = digitValue(w[1]);
    if (col == -1) {
        return -1;
    }
    if (d1 < 1) {
        return -1;
    }
    let row = d1;
    if (len(w) == 3) {
        let d2 = digitValue(w[2]);
        if (d2 == -1) {
            return -1;
        }
        row = d1 * 10 + d2;
    }
    return (row - 1) * 26 + col;
}

func cellName(id) {
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    return letters[id % 26] & (id / 26 + 1);
}

func isSymbol(c) {
    let symbols = "+-*/%(),:";
    for (let i = 0; i < len(symbols); i = i + 1) {
        if (symbols[i] == c) {
            return true;
        }
    }
    return false;
}

# Tokens: kinds[i] is "n" (number, value in vals[i]), "w" (a word of capitals
# and digits, text in words[i]) or the symbol itself. False on a bad character.
func tokenize(s, kinds, vals, words) {
    let i = 0;
    while (i < len(s)) {
        let c = s[i];
        if (c == " ") {
            i = i + 1;
        } else if (digitValue(c) != -1) {
            let v = 0;
            let more = true;
            while (more) {
                v = v * 10 + digitValue(s[i]);
                i = i + 1;
                more = false;
                if (i < len(s)) {
                    if (digitValue(s[i]) != -1) {
                        more = true;
                    }
                }
            }
            push(kinds, "n");
            push(vals, v);
            push(words, "");
        } else if (letterIndex(c) != -1) {
            let w = "";
            let more = true;
            while (more) {
                w = w & s[i];
                i = i + 1;
                more = false;
                if (i < len(s)) {
                    if (letterIndex(s[i]) != -1) {
                        more = true;
                    }
                    if (digitValue(s[i]) != -1) {
                        more = true;
                    }
                }
            }
            push(kinds, "w");
            push(vals, 0);
            push(words, w);
        } else if (isSymbol(c)) {
            push(kinds, c);
            push(vals, 0);
            push(words, "");
            i = i + 1;
        } else {
            return false;
        }
    }
    return true;
}

# The parser state ps is [kinds, vals, words, pos, failed].
func peek(ps) {
    if (ps[3] < len(ps[0])) {
        return ps[0][ps[3]];
    }
    return "end";
}

func expect(ps, kind) {
    if (peek(ps) != kind) {
        ps[4] = true;
        return false;
    }
    ps[3] = ps[3] + 1;
    return true;
}

func parseExpr(ps) {
    let node = parseTerm(ps);
    let k = peek(ps);
    while (k == "+" or k == "-") {
        if (ps[4]) {
            return node;
        }
        ps[3] = ps[3] + 1;
        let right = parseTerm(ps);
        node = ["bin", k, node, right];
        k = peek(ps);
    }
    return node;
}

func parseTerm(ps) {
    let node = parseUnary(ps);
    let k = peek(ps);
    while (k == "*" or k == "/" or k == "%") {
        if (ps[4]) {
            return node;
        }
        ps[3] = ps[3] + 1;
        let right = parseUnary(ps);
        node = ["bin", k, node, right];
        k = peek(ps);
    }
    return node;
}

func parseUnary(ps) {
    if (peek(ps) == "-") {
        ps[3] = ps[3] + 1;
        let inner = parseUnary(ps);
        return ["neg", inner];
    }
    return parsePrimary(ps);
}

func parsePrimary(ps) {
    let k = peek(ps);
    if (k == "n") {
        let v = ps[1][ps[3]];
        ps[3] = ps[3] + 1;
        return ["num", v];
    }
    if (k == "(") {
        ps[3] = ps[3] + 1;
        let node = parseExpr(ps);
        expect(ps, ")");
        return node;
    }
    if (k == "w") {
        let w = ps[2][ps[3]];
        ps[3] = ps[3] + 1;
        if (w == "SUM" or w == "MIN" or w == "MAX") {
            if (not expect(ps, "(")) {
                return ["num", 0];
            }
            let args = [];
            let a = parseArg(ps);
            push(args, a);
            while (peek(ps) == ",") {
                if (ps[4]) {
                    return ["num", 0];
                }
                ps[3] = ps[3] + 1;
                let b = parseArg(ps);
                push(args, b);
            }
            expect(ps, ")");
            return ["fn", w, args];
        }
        let id = cellId(w);
        if (id == -1) {
            ps[4] = true;
            return ["num", 0];
        }
        return ["ref", id];
    }
    ps[4] = true;
    return ["num", 0];
}

func parseArg(ps) {
    let isRange = false;
    if (peek(ps) == "w") {
        if (ps[3] + 1 < len(ps[0])) {
            if (ps[0][ps[3] + 1] == ":") {
                isRange = true;
            }
        }
    }
    if (not isRange) {
        return parseExpr(ps);
    }
    let a = cellId(ps[2][ps[3]]);
    ps[3] = ps[3] + 2;
    if (peek(ps) != "w") {
        ps[4] = true;
        return ["num", 0];
    }
    let b = cellId(ps[2][ps[3]]);
    ps[3] = ps[3] + 1;
    if (a == -1 or b == -1) {
        ps[4] = true;
        return ["num", 0];
    }
    return ["range", a, b];
}

# The tree for a formula, or none if it is malformed.
func parseFormula(src) {
    let ps = [[], [], [], 0, false];
    if (not tokenize(src, ps[0], ps[1], ps[2])) {
        return none;
    }
    let node = parseExpr(ps);
    if (ps[4]) {
        return none;
    }
    if (ps[3] != len(ps[0])) {
        return none;
    }
    return node;
}

func rangeCells(a, b) {
    let r0 = a / 26;
    let r1 = b / 26;
    if (r1 < r0) {
        let t = r0;
        r0 = r1;
        r1 = t;
    }
    let c0 = a % 26;
    let c1 = b % 26;
    if (c1 < c0) {
        let t = c0;
        c0 = c1;
        c1 = t;
    }
    let out = [];
    for (let r = r0; r <= r1; r = r + 1) {
        for (let c = c0; c <= c1; c = c + 1) {
            push(out, r * 26 + c);
        }
    }
    return out;
}

func collectRefs(node, out) {
    let kind = node[0];
    if (kind == "ref") {
        push(out, node[1]);
    } else if (kind == "range") {
        let cells = rangeCells(node[1], node[2]);
        for (let i = 0; i < len(cells); i = i + 1) {
            push(out, cells[i]);
        }
    } else if (kind == "neg") {
        collectRefs(node[1], out);
    } else if (kind == "bin") {
        collectRefs(node[2], out);
        collectRefs(node[3], out);
    } else if (kind == "fn") {
        let args = node[2];
        for (let i = 0; i < len(args); i = i + 1) {
            collectRefs(args[i], out);
        }
    }
}

# The sheet sh is [given, trees, deps, onCycle, done, values]; a value is
# ["int", n] or [error name, 0].
func reaches(sh, start, target, seen) {
    let deps = sh[2][start];
    for (let i = 0; i < len(deps); i = i + 1) {
        let d = deps[i];
        if (d == target) {
            return true;
        }
        if (not seen[d]) {
            seen[d] = true;
            if (reaches(sh, d, target, seen)) {
                return true;
            }
        }
    }
    return false;
}

func severity(kind) {
    if (kind == "#CYCLE") {
        return 3;
    }
    if (kind == "#ERR") {
        return 2;
    }
    if (kind == "#DIV0") {
        return 1;
    }
    return 0;
}

func value(sh, id) {
    if (not sh[0][id]) {
        return ["int", 0];
    }
    if (sh[4][id]) {
        return sh[5][id];
    }
    let v = ["int", 0];
    if (sh[3][id]) {
        v = ["#CYCLE", 0];
    } else if (sh[1][id] == none) {
        v = ["#ERR", 0];
    } else {
        let worst = "int";
        let deps = sh[2][id];
        for (let i = 0; i < len(deps); i = i + 1) {
            let dv = value(sh, deps[i]);
            if (severity(dv[0]) > severity(worst)) {
                worst = dv[0];
            }
        }
        if (worst != "int") {
            v = [worst, 0];
        } else {
            let fail = [false];
            let n = calc(sh, sh[1][id], fail);
            if (fail[0]) {
                v = ["#DIV0", 0];
            } else {
                v = ["int", n];
            }
        }
    }
    let done = sh[4];
    let values = sh[5];
    done[id] = true;
    values[id] = v;
    return v;
}

func calc(sh, node, fail) {
    let kind = node[0];
    if (kind == "num") {
        return node[1];
    }
    if (kind == "ref") {
        let v = value(sh, node[1]);
        return v[1];
    }
    if (kind == "neg") {
        let inner = calc(sh, node[1], fail);
        return -inner;
    }
    if (kind == "bin") {
        let a = calc(sh, node[2], fail);
        let b = calc(sh, node[3], fail);
        let op = node[1];
        if (op == "+") {
            return a + b;
        }
        if (op == "-") {
            return a - b;
        }
        if (op == "*") {
            return a * b;
        }
        if (b == 0) {
            fail[0] = true;
            return 0;
        }
        if (op == "/") {
            return a / b;
        }
        return a % b;
    }
    let vals = [];
    let args = node[2];
    for (let i = 0; i < len(args); i = i + 1) {
        if (args[i][0] == "range") {
            let cells = rangeCells(args[i][1], args[i][2]);
            for (let k = 0; k < len(cells); k = k + 1) {
                let v = value(sh, cells[k]);
                push(vals, v[1]);
            }
        } else {
            let n = calc(sh, args[i], fail);
            push(vals, n);
        }
    }
    let out = vals[0];
    for (let i = 1; i < len(vals); i = i + 1) {
        if (node[1] == "SUM") {
            out = out + vals[i];
        } else if (node[1] == "MIN") {
            if (vals[i] < out) {
                out = vals[i];
            }
        } else {
            if (vals[i] > out) {
                out = vals[i];
            }
        }
    }
    return out;
}

let cells = 26 * 99;
let given = [];
let sources = [];
for (let i = 0; i < cells; i = i + 1) {
    push(given, false);
    push(sources, "");
}
let line = readline();
while (line != none) {
    let sp = 0;
    while (line[sp] != " ") {
        sp = sp + 1;
    }
    let name = "";
    for (let i = 0; i < sp; i = i + 1) {
        name = name & line[i];
    }
    let src = "";
    for (let i = sp + 3; i < len(line); i = i + 1) {
        src = src & line[i];
    }
    let id = cellId(name);
    given[id] = true;
    sources[id] = src;
    line = readline();
}

let trees = [];
let deps = [];
let onCycle = [];
let done = [];
let values = [];
for (let i = 0; i < cells; i = i + 1) {
    let tree = none;
    let refs = [];
    if (given[i]) {
        tree = parseFormula(sources[i]);
        if (tree != none) {
            collectRefs(tree, refs);
        }
    }
    push(trees, tree);
    push(deps, refs);
    push(onCycle, false);
    push(done, false);
    push(values, none);
}
let sh = [given, trees, deps, onCycle, done, values];
for (let i = 0; i < cells; i = i + 1) {
    if (given[i]) {
        let seen = [];
        for (let k = 0; k < cells; k = k + 1) {
            push(seen, false);
        }
        onCycle[i] = reaches(sh, i, i, seen);
    }
}
for (let i = 0; i < cells; i = i + 1) {
    if (given[i]) {
        let v = value(sh, i);
        if (v[0] == "int") {
            print cellName(i) & " = " & v[1];
        } else {
            print cellName(i) & " = " & v[0];
        }
    }
}
